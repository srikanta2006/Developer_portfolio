# Environment Variables - Srikanta Bellamkonda Portfolio
# Copy this file to .env.local for local development.

# GitHub REST API Token (Optional)
# Used in Phase 4 for fetching public repository data and activity.
# Unauthenticated requests are permitted up to 60 req/hr.
# Provide a personal access token if higher rate limits are needed.
# GITHUB_TOKEN=

# Base URL for preview/production (Optional)
# NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Direct Messaging Delivery (Optional — defaults to server log if unset)
# RESEND_API_KEY=
# CONTACT_EMAIL=srikantacvr@gmail.com
# CONTACT_WEBHOOK_URL=
